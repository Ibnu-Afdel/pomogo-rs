{
  "schemaVersion": 1,
  "id": "pomogo.timer",
  "name": "PomoGo",
  "version": "4.0.2",
  "author": "Ibnu Afdel",
  "description": "Live PomoGo focus timer for the Omarchy bar",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "PomoGo",
    "description": "Countdown of the running PomoGo session. Click to open, right click to pause or resume, middle click to skip. Reports a missing pomogo command instead of disappearing.",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "display": "Icon and time",
      "showTask": "Off",
      "whenIdle": "Hide",
      "whenMissing": "Show"
    },
    "schema": [
      {
        "key": "display",
        "type": "enum",
        "label": "Show",
        "options": ["Icon and time", "Icon only"],
        "defaultValue": "Icon and time"
      },
      {
        "key": "showTask",
        "type": "enum",
        "label": "Show task name",
        "options": ["Off", "On"],
        "defaultValue": "Off"
      },
      {
        "key": "whenIdle",
        "type": "enum",
        "label": "While PomoGo is open but not started",
        "options": ["Hide", "Show"],
        "defaultValue": "Hide"
      },
      {
        "key": "whenMissing",
        "type": "enum",
        "label": "While the pomogo command is not installed",
        "options": ["Show", "Hide"],
        "defaultValue": "Show"
      }
    ]
  }
}
